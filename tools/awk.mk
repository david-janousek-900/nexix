# Task 174: awk's front end, with its parser, scanner and tables generated by
# the retained V7 yacc and lex on the host, as in the supplied makefile.
build/host-v7-lex: build/gen-lex/parser.c $(wildcard user/lex/*.c) | build/.dir
	$(HOST_CC) -std=gnu89 -funsigned-char -fcommon -w -Iuser/lex build/gen-lex/parser.c user/lex/lmain.c user/lex/sub1.c user/lex/sub2.c user/lex/header.c -o $@
# The native yacc sources: the bootstrap V7 yacc's lookahead sets are too
# narrow for awk's 76 tokens.
build/host-nx-yacc: $(wildcard user/yacc/*) | build/.dir
	$(HOST_CC) -std=gnu89 -funsigned-char -fcommon -w user/yacc/y1.c user/yacc/y2.c user/yacc/y3.c user/yacc/y4.c -o $@
AWK_GENERATED = build/gen-awk/y.tab.c build/gen-awk/awk.h build/gen-awk/awk.lx.c build/gen-awk/token.c build/gen-awk/proctab.c
$(AWK_GENERATED) &: build/host-nx-yacc build/host-v7-lex tools/awk_generate.py user/awk/awk.g.y user/awk/awk.lx.l user/awk/token.c user/awk/proc.c user/awk/awk.def rootfs/usr/lib/yaccpar rootfs/usr/lib/lex/ncform
	$(PYTHON) tools/awk_generate.py $(HOST_CC)
AWK_NAMES = b main tran lib run parse
AWK_OBJECTS = build/awk-y.tab.o build/awk-awk.lx.o build/awk-token.o build/awk-proctab.o $(addprefix build/awk-,$(addsuffix .o,$(AWK_NAMES)))
AWK_CFLAGS = $(V7_CFLAGS) -Wno-unused-variable -Wno-unused-but-set-variable -Wno-sign-compare -Wno-return-mismatch -Ibuild/gen-awk -Iuser/awk
build/awk-%.o: build/gen-awk/%.c user/awk/awk.def | build/.dir
	$(CC) $(AWK_CFLAGS) -Iuser/awk -c $< -o $@
build/awk-%.o: user/awk/%.c user/awk/awk.def build/gen-awk/awk.h | build/.dir
	$(CC) $(AWK_CFLAGS) -c $< -o $@
build/v7-awk.elf: build/crt0.o $(AWK_OBJECTS) build/libm.a build/libc.a user/user.ld
	$(LD) -nostdlib -z max-page-size=0x1000 -T user/user.ld $(filter %.o %.a,$^) -o $@
-include $(AWK_OBJECTS:.o=.d)
# Private front-end harness: the awk objects without main.o.
build/awk-tree.o: tests/awk_parse.c user/awk/awk.def build/gen-awk/awk.h | build/.dir
	$(CC) $(AWK_CFLAGS) -c $< -o $@
build/awk-parse.elf: build/crt0.o build/awk-tree.o $(filter-out build/awk-main.o,$(AWK_OBJECTS)) build/libm.a build/libc.a user/user.ld
	$(LD) -nostdlib -z max-page-size=0x1000 -T user/user.ld $(filter %.o %.a,$^) -o $@
# The supplied proc helper, built natively for guest regeneration of proctab.c.
build/awk-proc.o: user/awk/proc.c build/gen-awk/awk.h | build/.dir
	$(CC) $(AWK_CFLAGS) -c $< -o $@
build/awk-proc.elf: build/crt0.o build/awk-proc.o build/awk-token.o build/libc.a user/user.ld
	$(LD) -nostdlib -z max-page-size=0x1000 -T user/user.ld $(filter %.o %.a,$^) -o $@
.PHONY: test-awk-parse-unit test-awk-parse
test-awk-parse-unit:
	$(PYTHON) tests/awk.py
test-awk-parse: test-awk-parse-unit multi-iso rootfs
	$(PYTHON) tools/awk_parse_smoke.py $(QEMU) build/nexix-multi.iso 16M
	$(PYTHON) tools/awk_parse_smoke.py $(QEMU) build/nexix-multi.iso 128M
test: test-awk-parse
test-unit: test-awk-parse-unit
